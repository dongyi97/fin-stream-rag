# Kafka Consumer (news_refine_stream_pandas.py) 전용 Docker 이미지
FROM python:3.10-slim

WORKDIR /app

# 시스템 패키지 설치
RUN apt-get update && apt-get install -y --no-install-recommends \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Python 패키지 설치
COPY requirements-docker.txt /app/requirements-docker.txt
RUN pip install --no-cache-dir -r requirements-docker.txt

# 소스 코드 복사
COPY kafka_fin /app/kafka_fin

# 작업 디렉토리 설정
WORKDIR /app

# 기본 실행 명령어
CMD ["python", "-u", "kafka_fin/consumer/news_refine_stream_pandas.py"]
